{
  "name": "praxis-quality",
  "private": true,
  "version": "0.1.0-alpha.44",
  "description": "Praxis Quality Skills plugin and praxis-quality.zip (HTTP worker stays in Runtime)",
  "workspaces": [
    "plugins/*",
    "tools/scripts"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "plugins:validate": "node tools/scripts/validate-plugins.mjs",
    "pack:zip": "node tools/scripts/pack-claude-plugins.mjs --version 0.1.0-alpha.44",
    "check:skill-cli": "node tools/scripts/check-skill-cli.mjs",
    "check:boundaries": "node tools/scripts/check-boundaries.mjs",
    "accept:claude-plugins": "node tools/scripts/claude-plugins-acceptance.mjs",
    "accept:claude-hosted-plugins": "node tools/scripts/claude-hosted-plugins-acceptance.mjs",
    "accept:quality-governance": "node tools/scripts/quality-governance-acceptance.mjs --rebuild",
    "verify": "npm run test && npm run plugins:validate && npm run check:skill-cli && npm run check:boundaries && npm run pack:zip && npm run accept:claude-plugins"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@praxis/plugin-sdk": "file:vendor/praxis-plugin-sdk-0.1.0-alpha.44.tgz",
    "@praxis/knowledge": "file:vendor/praxis-knowledge-0.1.0-alpha.44.tgz",
    "@praxis/project-config": "file:vendor/praxis-project-config-0.1.0-alpha.44.tgz",
    "@praxis/jira": "file:vendor/praxis-jira-0.1.0-alpha.44.tgz",
    "@praxis/contracts": "file:vendor/praxis-contracts-0.1.0-alpha.44.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfg-inc/praxis-quality.git"
  },
  "bugs": {
    "url": "https://github.com/dfg-inc/praxis-quality/issues"
  },
  "homepage": "https://github.com/dfg-inc/praxis-quality"
}
